generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ────────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  firstName           String    @map("first_name")
  lastName            String    @map("last_name")
  isEmailVerified     Boolean   @default(false) @map("is_email_verified")
  emailVerifyToken    String?   @unique @map("email_verify_token")
  emailVerifyExpires  DateTime? @map("email_verify_expires")
  country             String?

  refreshTokens RefreshToken[]
  products      Product[]
  orders        Order[]         @relation("BuyerOrders")
  soldOrders    Order[]         @relation("SellerOrders")
  escrows       Escrow[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  replacedByToken String? @map("replaced_by_token")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── PRODUCTS ────────────────────────────────────────────────────────────────

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  products Product[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  title       String
  description String
  priceFCFA   Int           @map("price_fcfa")
  priceUSD    Int           @map("price_usd")
  status      ProductStatus @default(DRAFT)

  sellerId   String   @map("seller_id")
  seller     User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id])

  images   ProductImage[]
  variants ProductVariant[]
  orderItems OrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model ProductImage {
  id        String  @id @default(uuid())
  url       String
  publicId  String  @map("public_id")
  position  Int     @default(0)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id        String @id @default(uuid())
  size      String
  color     String
  quantity  Int    @default(0)
  productId String @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]

  @@unique([productId, size, color])
  @@map("product_variants")
}

// ─── ORDERS ──────────────────────────────────────────────────────────────────

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique @map("order_number")
  status      OrderStatus @default(CREATED)

  buyerId  String @map("buyer_id")
  buyer    User   @relation("BuyerOrders", fields: [buyerId], references: [id])
  sellerId String @map("seller_id")
  seller   User   @relation("SellerOrders", fields: [sellerId], references: [id])

  totalFCFA Int @map("total_fcfa")
  totalUSD  Int @map("total_usd")

  items    OrderItem[]
  escrow   Escrow?
  payments Payment[]
  disputes Dispute[]

  shippingAddress String? @map("shipping_address")
  trackingNumber  String? @map("tracking_number")

  paidAt      DateTime? @map("paid_at")
  shippedAt   DateTime? @map("shipped_at")
  deliveredAt DateTime? @map("delivered_at")
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@map("orders")
}

enum OrderStatus {
  CREATED
  PAYMENT_PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}

model OrderItem {
  id        String @id @default(uuid())
  quantity  Int
  unitPriceFCFA Int @map("unit_price_fcfa")
  unitPriceUSD  Int @map("unit_price_usd")

  orderId   String @map("order_id")
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  variantId String? @map("variant_id")
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Escrow {
  id       String       @id @default(uuid())
  status   EscrowStatus @default(HOLDING)
  amountFCFA Int        @map("amount_fcfa")
  amountUSD  Int        @map("amount_usd")

  orderId String @unique @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id])
  holderId String @map("holder_id")
  holder   User   @relation(fields: [holderId], references: [id])

  releaseScheduledAt DateTime? @map("release_scheduled_at")
  releasedAt         DateTime? @map("released_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("escrows")
}

enum EscrowStatus {
  HOLDING
  RELEASE_SCHEDULED
  RELEASED
  DISPUTED
  REFUNDED
}

// ─── PAYMENTS ────────────────────────────────────────────────────────────────

model Payment {
  id            String        @id @default(uuid())
  provider      String        // "cinetpay" | "flutterwave"
  transactionId String        @unique @map("transaction_id")
  status        PaymentStatus @default(PENDING)
  amount        Int
  currency      String        // "XOF", "USD"

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id])

  paymentUrl String? @map("payment_url")
  rawData    Json?   @map("raw_data")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
}

model Dispute {
  id     String        @id @default(uuid())
  reason String
  status DisputeStatus @default(OPEN)

  orderId  String @map("order_id")
  order    Order  @relation(fields: [orderId], references: [id])
  openedBy String @map("opened_by")

  resolvedBy     String?   @map("resolved_by")
  resolution     String?
  resolvedAt     DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("disputes")
}

enum DisputeStatus {
  OPEN
  RESOLVED_BUYER
  RESOLVED_SELLER
  CLOSED
}
